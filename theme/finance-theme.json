{
  "name": "Finance Dashboard",
  "dataColors": [
    "#1F4E79",
    "#2E86AB",
    "#1B7F5B",
    "#C98A1B",
    "#C2413A",
    "#6C5B7B",
    "#5A6B7D",
    "#8FB8DE"
  ],
  "good": "#1B7F5B",
  "neutral": "#C98A1B",
  "bad": "#C2413A",
  "maximum": "#1F4E79",
  "center": "#8FB8DE",
  "minimum": "#EEF3F8",
  "background": "#FFFFFF",
  "foreground": "#1E2A38",
  "tableAccent": "#1F4E79",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1E2A38" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1E2A38" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5A6B7D" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1E2A38" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E3E8EE" } }, "radius": 6 }],
        "dropShadow": [{ "show": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F9" } }, "transparency": 0 }]
      }
    },
    "waterfallChart": {
      "*": {
        "sentimentColors": [
          {
            "increaseFill": { "solid": { "color": "#1B7F5B" } },
            "decreaseFill": { "solid": { "color": "#C2413A" } },
            "totalFill": { "solid": { "color": "#1F4E79" } }
          }
        ]
      }
    }
  }
}
